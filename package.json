{
  "name": "answerable",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "generate-routes": "tsr generate",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "mutate": "stryker run",
    "verify": "pnpm check && pnpm types && pnpm test && pnpm e2e",
    "types:watch": "tsc --noEmit --watch",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
